<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/profile.css">
  <link rel="shortcut icon" href="/images/flavicon-04.png">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
    crossorigin="anonymous" referrerpolicy="no-referrer">
  <title>Profile</title>
</head>

<body>
  <header>
    <div class="logo">
      <img src="/images/heavy-bar-logo.png" alt="logo">
    </div>
    <nav>
      <button id="training_btn">Training</button>
    </nav>
  </header>
  <div class="profile" style="display: block">
    <h2>Your profile</h2>
    <div class="wrapper">
      <form class="update-member-form">
        <div class="basic_informations">
          <div class="profile_pic">
            <img src="<%= member.photo ? `/${member.photo}` : '/images/your-profile-default-pic.png' %>" id="photo"
              alt="profile_pic">
            <input type="file" id="file">
            <label for="file" id="upload_pic">
              <i class="fa-solid fa-camera"></i>
            </label>
          </div>
          <div class="personal_info">
            <div class="profile-fname-lname">
              <div class="profile-fname">
                <label for="fname">First name: </label>
                <input type="text" id="fname" value="<%= member.firstName %>">
              </div>
              <div class="profile-lname">
                <label for="lname">Last name: </label>
                <input type="text" id="lname" value="<%= member.lastName %>">
              </div>
            </div>
            <div class="profile-email-pnumber">
              <div class="profile-email">
                <label for="email">Email: </label>
                <input type="email" id="email" value="<%= member.email %>">
              </div>
              <div class="profile-pnumber">
                <label for="tel">Phone number:</label>
                <input type="tel" id="tel" value="<%= member.phoneNumber %>">
              </div>
            </div>
            <div class="profile-address-sex">
              <div class="profile-address-sex">
                <label for="address">Address: </label>
                <input type="text" id="address" value="<%= member.address %>">
              </div>
              <div class="profile-sex">
                <label for="sex">Sex:</label>
                <select name="sex" id="sex">
                  <option value="male" <%=member.sex==='male' ? 'selected' : '' %>>Male</option>
                  <option value="female" <%=member.sex==='female' ? 'selected' : '' %>>Female</option>
                  <option value="other" <%=member.sex==='other' ? 'selected' : '' %>>Other</option>
                </select>
              </div>
            </div>
          </div>
        </div>
        <div class="additional_info">
          <div class="goal">
            <label for="goal">Goal:</label>
            <input type="text" id="goal" value="<%= member.goal %>">
          </div>
          <div class="program">
            <label for="program">Program:</label>
            <input type="text" id="program" name="program" value="<%= member.program %>">
          </div>
          <p>Membership: </p>
        </div>
        <div class="measurements">
          <div class="height_weight">
            <div class="height">
              <label for="height">Height: </label>
              <input type="text" id="height" placeholder="cm" value="<%= member.height %>">
            </div>
            <div class="weight">
              <label for="weight">Weight: </label>
              <input type="text" id="weight" placeholder="kg" value="<%= member.weight %>">
            </div>
          </div>
          <div class="bfat_bmi">
            <div class="body_fat">
              <label for="bfat">Body fat:</label>
              <input type="text" id="bfat" placeholder="%" value="<%= member.bodyFat %>">
            </div>
            <div class="bmi">
              <label for="bmi">BMI:</label>
              <input type="text" id="bmi" placeholder="" value="<%= member.bmi %>">
            </div>
          </div>
          <div class="waist_arm">
            <div class="waist">
              <label for="waist">Waist:</label>
              <input type="text" id="waist" placeholder="cm" value="<%= member.waist %>">
            </div>
            <div class="arm">
              <label for="arm">Arm:</label>
              <input type="text" id="arm" placeholder="cm" value="<%= member.arm %>">
            </div>
          </div>
          <div class="thigh">
            <label for="thigh">Thigh: </label>
            <input type="text" id="thigh" placeholder="cm" value="<%= member.thigh %>">
          </div>
        </div>
        <div class="experience">
          <div class="exp_head">
            <label>Experience:</label>
          </div>
          <div class="select_options">
            <div class="exp-beg">
              <label for="exp-beg">Beginner:</label>
              <input type="radio" id="exp-beg" name="experience" value="beginner" <%=member.experience==='beginner'
                ? 'checked' : '' %>>
            </div>
            <div class="exp-int">
              <label for="exp-int">Intermediate:</label>
              <input type="radio" id="exp-int" name="experience" value="intermediate"
                <%=member.experience==='intermediate' ? 'checked' : '' %>>
            </div>
            <div class="exp-adv">
              <label for="exp-adv">Advanced:</label>
              <input type="radio" id="exp-adv" name="experience" value="advanced" <%=member.experience==='advanced'
                ? 'checked' : '' %>>
            </div>
          </div>
        </div>
        <div class="records">
          <p>Records: </p>
          <div class="personal-best">
            <div class="squat">
              <label for="squat">Squat: </label>
              <input type="number" id="squat" placeholder="100" value="<%= member.squat %>">
            </div>
            <div class="bench">
              <label for="bench">Bench: </label>
              <input type="number" id="bench" placeholder="80" value="<%= member.bench %>">
            </div>
            <div class="deadlift">
              <label for="deadlift">Deadlift: </label>
              <input type="number" id="deadlift" placeholder="100" value="<%= member.deadlift %>">
            </div>
          </div>
        </div>
        <div class="btns">
          <input class="btn" type="submit" value="Save">
          <input class="btn" type="reset" value="Delete">
        </div>
      </form>
    </div>
  </div>
  <div class="training-container" style="display: none">
    <h2>push/pull/legs</h2>
    <div class="training">
      <% ['Push', 'Push' ].forEach(type=> { %>
        <div class="one">
          <div class="upper">
            <p>
              <%= type %>
            </p>
          </div>
          <div class="lower">
            <% for(let i=0; i < 10; i++) { %>
              <div class="exercise-card">
                <div class="exercise-thumb">
                  <img src="/images/about-us.jpg" alt="exercise">
                </div>
                <h4>Naziv vezbe</h4>
                <div class="exercise-details">
                  <div class="sets">
                    <p>Sets</p>
                    <p>4</p>
                  </div>
                  <div class="reps">
                    <p>Reps</p>
                    <p>12</p>
                  </div>
                  <div class="weight">
                    <p>Weight (kg)</p>
                    <p>40</p>
                  </div>
                </div>
              </div>
              <% } %>
          </div>
        </div>
        <% }); %>
    </div>

    <div class="modal-exercise-back">
      <div class="modal-exercise">
        <div class="modal-header">
          <h3>Name of the exercise</h3>
          <div class="video-instruction">
            <div class="video">
              <img src="/images/about-us.jpg" alt="">
            </div>
            <div class="instruction">
              <form>
                <textarea placeholder="Input instructions"></textarea>
              </form>
            </div>
          </div>
        </div>
        <div class="wrapper_adjust">
          <div class="rows-container">
            <div class="exercise-row">
              <div class="header-row">
                <span>SETS</span>
                <span>REPS</span>
                <span>WEIGHT</span>
                <span>REST</span>
                <button class="add-row" onclick="addRow()">Add Row</button>
              </div>
            </div>
            <div class="exercise-row">
              <div class="input-row">
                <div class="exercise-field">
                  <div class="counter">
                    <input class="value" data-type="sets" type="number" placeholder="0" value="0">
                    <button onclick="updateField(this, 'sets', 1)">+</button>
                    <button onclick="updateField(this, 'sets', -1)">-</button>
                  </div>
                </div>
                <div class="exercise-field">
                  <div class="counter">
                    <input class="value" data-type="reps" type="number" placeholder="0" value="0">
                    <button onclick="updateField(this, 'reps', 1)">+</button>
                    <button onclick="updateField(this, 'reps', -1)">-</button>
                  </div>
                </div>
                <div class="exercise-field">
                  <div class="counter">
                    <input class="value" data-type="weight" type="number" placeholder="0" value="0">
                    <button onclick="updateField(this, 'weight', 2.5)">+</button>
                    <button onclick="updateField(this, 'weight', -2.5)">-</button>
                  </div>
                </div>
                <div class="exercise-field">
                  <div class="counter">
                    <input class="value" data-type="rest" type="number" placeholder="0" value="0">
                    <button onclick="updateField(this, 'rest', 60)">+</button>
                    <button onclick="updateField(this, 'rest', -60)">-</button>
                  </div>
                </div>
                <div class="exercise-field">
                  <div class="row-actions">
                    <span onclick="copyRow(this)"><i class="fa-regular fa-copy"></i></span>
                    <span onclick="deleteRow(this)"><i class="fa-solid fa-trash"></i></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <button class="save">Save</button>
        </div>
      </div>
    </div>
  </div>


  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="/js/bundle.js"></script>
  <script src="/js/profile.js"></script>
</body>

</html>