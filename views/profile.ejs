<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Exercise Modal</title>
  <link rel="stylesheet" href="/css/profile.css" type="text/css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
</head>

<body>
  <header>
    <div class="logo">
      <img src="/images/heavy-bar-logo.png" alt="logo">
    </div>
    <nav>
      <button id="training_btn">Training</button>
    </nav>
  </header>
  <div class="profile" style="display: block">
    <h2>Your profile</h2>
    <div class="wrapper">
      <form class="update-member-form">
        <div class="basic_informations">
          <div class="profile_pic">
            <img src="/images/your-profile-default-pic.png" id="photo" alt="profile_pic">
            <input type="file" id="file">
            <label for="file" id="upload_pic">
              <i class="fa-solid fa-camera"></i>
            </label>
          </div>
          <div class="personal_info">
            <div class="profile-fname-lname">
              <div class="profile-fname">
                <label for="firstName">First name: </label>
                <input type="text" id="firstName" name="firstName" value="<%= member.firstName %>">
              </div>
              <div class="profile-lname">
                <label for="lastName">Last name: </label>
                <input type="text" id="lastName" name="lastName" value="<%= member.lastName %>">
              </div>
            </div>
            <div class="profile-email-pnumber">
              <div class="profile-email">
                <label for="email">Email: </label>
                <input type="email" id="email" name="email" value="<%= member.email %>">
              </div>
              <div class="profile-pnumber">
                <label for="phoneNumber">Phone number: </label>
                <input type="tel" id="phoneNumber" name="phoneNumber" value="<%= member.phoneNumber %>">
              </div>
            </div>
            <div class="profile-address-sex">
              <div class="profile-address-sex">
                <label for="address">Address: </label>
                <input type="text" id="address" name="address" value="<%= member.address %>">
              </div>
              <!-- <div class="profile-sex">
              <label for="sex">Sex:</label>
              <select name="sex" id="sex">
                <option value="male">Male</option>
                <option value="female">Female</option>
                <option value="other">Other</option>
              </select>
            </div> -->
            </div>
          </div>
        </div>
        <div class="additional_info">
          <div class="goal">
            <label for="goal">Goal:</label>
            <input type="text" id="goal" name="goal" value="<%= member.goal %>">
          </div>
          <div class="program">
            <label for="program">Program:</label>
            <input type="text" id="program" name="program" value="<%= member.program %>">
          </div>
          <p>Membership: </p>
        </div>
        <div class="measurements">
          <div class="height_weight">
            <div class="height">
              <label for="height">Height: </label>
              <input type="text" id="height" placeholder="cm" name="height" value="<%= member.height %>">
            </div>
            <div class="weight">
              <label for="weight">Weight: </label>
              <input type="text" id="weight" placeholder="kg" name="weight" value="<%= member.weight %>">
            </div>
          </div>
          <div class="bfat_bmi">
            <div class="body_fat">
              <label for="bfat">Body fat:</label>
              <input type="text" id="bfat" placeholder="%" name="bodyFat" value="<%= member.bodyFat %>">
            </div>
            <div class="bmi">
              <label for="bmi">BMI:</label>
              <input type="text" id="bmi" placeholder="" name="bmi" value="<%= member.bmi %>">
            </div>
          </div>
          <div class="waist_arm">
            <div class="waist">
              <label for="waist">Waist:</label>
              <input type="text" id="waist" placeholder="cm" name="waist" value="<%= member.waist %>">
            </div>
            <div class="arm">
              <label for="arm">Arm:</label>
              <input type="text" id="arm" placeholder="cm" name="arm" value="<%= member.arm %>">
            </div>
          </div>
          <div class="thigh">
            <label for="thigh">Thigh: </label>
            <input type="text" id="thigh" placeholder="cm" name="thigh" value="<%= member.thigh %>">
          </div>
        </div>
        <div class="experience">
          <div class="exp_head">
            <label>Experiance:</label>
          </div>
          <div class="select_options">
            <div class="exp-beg">
              <label for="exp-beg">Beginner:</label>
              <input type="radio" id="exp-beg" name="experiance" value="beginner">
            </div>
            <div class="exp-int">
              <label for="exp-int">Intermediate:</label>
              <input type="radio" id="exp-int" name="experiance" value="intermediate">
            </div>
            <div class="exp-adv">
              <label for="exp-adv">Advanced:</label>
              <input type="radio" id="exp-adv" name="experiance" value="advanced">
            </div>
          </div>
        </div>
        <div class="records">
          <p>Records: </p>
          <div class="personal-best">
            <div class="squat">
              <label for="squat">Squat: </label>
              <input type="number" id="squat" placeholder="100" name="squat" value="<%= member.squat %>">
            </div>
            <div class="bench">
              <label for="bench">Bench: </label>
              <input type="number" id="bench" placeholder="80" name="bench" value="<%= member.bench %>">
            </div>
            <div class="deadlift">
              <label for="deadlift">Deadlift: </label>
              <input type="number" id="deadlift" placeholder="100" name="deadlift" value="<%= member.deadlift %>">
            </div>
          </div>
        </div>
        <div class="btns">
          <input class="btn" type="submit" value="Save">
          <input class="btn" type="reset" value="Delete">
        </div>
      </form>
    </div>
  </div>
