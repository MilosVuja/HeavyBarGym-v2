<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="/images/flavicon-04.png" type="tablogo">
  <title>Group training schedule</title>
  <link rel="stylesheet" href="/css/groupClassBooking.css" type="text/css">
</head>
<body>
  <div id="modal" class="modal-booking">
    <div id="modal-content" class="modal-container"></div>
  </div>
  <div class="container">
    <header>
      <div class="logo">
        <img src="/images/heavy-bar-logo.png" alt="logo">
      </div>
      <div class="schedule-headline">
        <h2>Group training schedule</h2>
      </div>
      <div class="back-home-btn">
        <a class="backh-btn" href="/">Go back</a>
      </div>
    </header>
    <table>
      <thead>
        <tr id="header-row"></tr>
      </thead>
      <tbody id="table-body"></tbody>
    </table>
    <section>
      <div class="legend">
        <h4>Legend:</h4>
        <div class="legend-desc">
          <div class="advanced">
            <div class="redl"></div>
            <p>advanced</p>
          </div>
          <div class="intermediate">
            <div class="bluel"></div>
            <p>intermediate</p>
          </div>
          <div class="beginner">
            <div class="yellowl"></div>
            <p>beginner</p>
          </div>
        </div>
      </div>
      <div class="remove-booking">
        <p>If you want to cancel your booking for group class, please<br> enter your email address and pin code that you
          got from us! </p>
        <form>
          <div class="email">
            <label for="email">Email:</label><br>
            <input type="email" id="email" placeholder="Email" required />
          </div>
          <div class="pin-number">
            <label for="number">PIN code:</label><br>
            <input type="text" id="number" placeholder="PIN code">
          </div>
          <input type="submit" class="cancel-booking" value="Cancel">
        </form>
      </div>
    </section>
  </div>

  <script src="/js/groupClassBooking.js"></script>
</body>
</html>